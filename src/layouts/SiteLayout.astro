---
import "../styles/global.css";
import { siteConfig, siteLinks } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const {
  title = "Traders Automatizados | Engenharia que transforma ideias em tecnologia real",
  description = siteConfig.description,
  robots = "index, follow",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const organizationId = new URL("#organization", siteConfig.url).href;
const websiteId = new URL("#website", siteConfig.url).href;
const socialImage = new URL("/og-cover.svg", Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: siteConfig.name,
      legalName: siteConfig.legalName,
      url: siteConfig.url,
      email: siteLinks.institutionalEmail,
      sameAs: [siteLinks.instagram],
      brand: {
        "@type": "Brand",
        name: siteConfig.brand.name,
        url: siteConfig.brand.url,
      },
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: siteConfig.name,
      url: siteConfig.url,
      inLanguage: "pt-BR",
      publisher: { "@id": organizationId },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical.href}#webpage`,
      name: title,
      description,
      url: canonical.href,
      inLanguage: "pt-BR",
      isPartOf: { "@id": websiteId },
      about: { "@id": organizationId },
      primaryImageOfPage: socialImage.href,
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07080a" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        const preferenceKey = "traders-automatizados-theme";
        const root = document.documentElement;
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
        const readPreference = () => {
          try {
            const saved = window.localStorage.getItem(preferenceKey);
            return saved === "light" || saved === "dark" ? saved : "auto";
          } catch {
            return "auto";
          }
        };

        let preference = readPreference();

        const syncControl = () => {
          const control = document.getElementById("theme-preference");
          const label = document.getElementById("theme-preference-label");
          const options = document.getElementById("theme-options");
          if (!(control instanceof HTMLButtonElement)) return;

          const labels = { auto: "Automático", light: "Claro", dark: "Escuro" };
          const effectiveTheme = preference === "auto" ? (systemTheme.matches ? "dark" : "light") : preference;
          control.dataset.preference = preference;
          control.dataset.effectiveTheme = effectiveTheme;
          control.setAttribute("aria-label", `Tema atual: ${labels[preference]}. Abrir opções de tema`);
          if (label) label.textContent = labels[preference];

          options?.querySelectorAll("button[data-theme-value]").forEach((option) => {
            option.setAttribute("aria-pressed", String(option.dataset.themeValue === preference));
          });
        };

        const applyTheme = () => {
          const theme = preference === "auto" ? (systemTheme.matches ? "dark" : "light") : preference;
          root.dataset.theme = theme;
          root.dataset.themePreference = preference;
          document.querySelector('meta[name="color-scheme"]')?.setAttribute("content", theme);
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", theme === "dark" ? "#07080a" : "#f4f6f9");
          syncControl();
        };

        const setPreference = (nextPreference) => {
          preference = nextPreference;
          try {
            if (preference === "auto") {
              window.localStorage.removeItem(preferenceKey);
            } else {
              window.localStorage.setItem(preferenceKey, preference);
            }
          } catch {
            // The selected mode still applies for this page if storage is unavailable.
          }
          applyTheme();
        };

        applyTheme();

        const followSystemTheme = () => {
          if (preference === "auto") applyTheme();
        };

        systemTheme.addEventListener("change", followSystemTheme);

        window.addEventListener("storage", (event) => {
          if (event.key !== preferenceKey && event.key !== null) return;
          preference = readPreference();
          applyTheme();
        });

        document.addEventListener("DOMContentLoaded", () => {
          const control = document.getElementById("theme-preference");
          const container = document.getElementById("theme-control");
          const options = document.getElementById("theme-options");
          if (!(control instanceof HTMLButtonElement) || !(container instanceof HTMLElement) || !(options instanceof HTMLElement)) return;
          syncControl();

          const closeOptions = (returnFocus = false) => {
            control.setAttribute("aria-expanded", "false");
            options.hidden = true;
            if (returnFocus) control.focus();
          };

          control.addEventListener("click", () => {
            const isExpanded = control.getAttribute("aria-expanded") === "true";
            control.setAttribute("aria-expanded", String(!isExpanded));
            options.hidden = isExpanded;
            if (!isExpanded) {
              options.querySelector(`button[data-theme-value="${preference}"]`)?.focus();
            }
          });

          options.addEventListener("click", (event) => {
            const target = event.target;
            const option = target instanceof Element ? target.closest("button[data-theme-value]") : null;
            if (!(option instanceof HTMLButtonElement)) return;

            const selected = option.dataset.themeValue;
            setPreference(selected === "light" || selected === "dark" ? selected : "auto");
            closeOptions(true);
          });

          container.addEventListener("keydown", (event) => {
            if (event.key !== "Escape" || control.getAttribute("aria-expanded") !== "true") return;
            event.preventDefault();
            event.stopPropagation();
            closeOptions(true);
          });

          container.addEventListener("focusout", () => {
            requestAnimationFrame(() => {
              if (!container.contains(document.activeElement)) closeOptions();
            });
          });

          document.addEventListener("pointerdown", (event) => {
            if (control.getAttribute("aria-expanded") !== "true") return;
            if (!(event.target instanceof Node) || !container.contains(event.target)) closeOptions();
          });
        });
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={siteConfig.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link
      rel="preload"
      href="/fonts/open-sans-v44-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/poppins-v24-500-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-v24-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>

    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta
      property="og:image:alt"
      content="Traders Automatizados — engenharia, software e automação"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
