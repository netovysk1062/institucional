---
import { siteLinks, sitePages } from "../data/site";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrentPage = (href: string) => (href.replace(/\/+$/, "") || "/") === currentPath;
---

<header class="site-header">
  <div class="site-header__inner shell mx-auto flex items-center justify-between">
    <a
      class="brand-lockup"
      href="/"
      aria-current={isCurrentPage("/") ? "page" : undefined}
    >
      <img
        class="brand-lockup__logo"
        src="/assets/logo-160.webp"
        width="160"
        height="160"
        alt=""
        loading="eager"
        decoding="async"
      />
      <span class="brand-lockup__name">
        <span>TRADERS</span>
        <span>AUTOMATIZADOS</span>
      </span>
    </a>

    <nav class="site-nav" id="menu-principal" aria-label="Navegação principal">
      <ul class="site-nav__list">
        {sitePages.map((link) => (
          <li>
            <a
              class="site-nav__link"
              href={link.href}
              aria-current={isCurrentPage(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li class="site-nav__theme">
          <div class="theme-control" id="theme-control">
            <button
              class="theme-trigger"
              id="theme-preference"
              type="button"
              aria-controls="theme-options"
              aria-expanded="false"
              aria-label="Tema atual: Automático. Abrir opções de tema"
              data-preference="auto"
              data-effective-theme="light"
            >
              <svg class="theme-trigger__icon theme-trigger__icon--auto" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3.5" y="4.5" width="17" height="12" rx="2" />
                <path d="M8.5 20h7m-3.5-3.5V20m0-12v4m-2-2h4" />
              </svg>
              <svg class="theme-trigger__icon theme-trigger__icon--light" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2.5v2m0 15v2m9.5-9.5h-2m-15 0h-2m16.22-6.72-1.42 1.42M6.7 17.3l-1.42 1.42m13.44 0-1.42-1.42M6.7 6.7 5.28 5.28" />
              </svg>
              <svg class="theme-trigger__icon theme-trigger__icon--dark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M20.1 15.2A8.5 8.5 0 0 1 8.8 3.9 8.7 8.7 0 1 0 20.1 15.2Z" />
              </svg>
              <span class="theme-trigger__label" id="theme-preference-label">Automático</span>
              <svg class="theme-trigger__chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="m4 6 4 4 4-4" />
              </svg>
            </button>

            <div class="theme-options" id="theme-options" role="group" aria-label="Opções de tema" hidden>
              <button class="theme-option" type="button" data-theme-value="auto" aria-pressed="true">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="3.5" y="4.5" width="17" height="12" rx="2" />
                  <path d="M8.5 20h7m-3.5-3.5V20m0-12v4m-2-2h4" />
                </svg>
                <span>Automático</span>
              </button>
              <button class="theme-option" type="button" data-theme-value="light" aria-pressed="false">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2.5v2m0 15v2m9.5-9.5h-2m-15 0h-2m16.22-6.72-1.42 1.42M6.7 17.3l-1.42 1.42m13.44 0-1.42-1.42M6.7 6.7 5.28 5.28" />
                </svg>
                <span>Claro</span>
              </button>
              <button class="theme-option" type="button" data-theme-value="dark" aria-pressed="false">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M20.1 15.2A8.5 8.5 0 0 1 8.8 3.9 8.7 8.7 0 1 0 20.1 15.2Z" />
                </svg>
                <span>Escuro</span>
              </button>
            </div>
          </div>
        </li>
        <li class="site-nav__mobile-action">
          <a
            class="button button--primary site-nav__mobile-cta"
            href={siteLinks.neuroLicence}
            target="_blank"
            rel="noopener noreferrer"
          >
            Soluções empresariais <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="site-header__actions">
      <a
        class="button button--header"
        href={siteLinks.neuroLicence}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Conhecer as soluções empresariais da NeuroLicence"
      >
        Soluções empresariais <span aria-hidden="true">↗</span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-controls="menu-principal"
        aria-expanded="false"
        aria-label="Abrir menu"
      >
        <span class="menu-toggle__lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  import { setupNavigation } from "../scripts/navigation";
  import { setupScrollReveal } from "../scripts/scroll-reveal";

  setupNavigation();
  setupScrollReveal();
</script>
