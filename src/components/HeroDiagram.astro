<div
  class="hero-diagram"
  role="img"
  aria-label="Diagrama ilustrativo: a base de engenharia de software conecta tecnologia financeira, soluções empresariais da NeuroLicence e plataformas próprias."
>
  <div class="hero-diagram__head">
    <span class="hero-diagram__eyebrow">ECOSSISTEMA TECNOLÓGICO</span>
    <span class="hero-diagram__index">SISTEMAS / 01</span>
  </div>

  <div class="hero-diagram__map">
    <svg
      class="hero-diagram__connections"
      viewBox="0 0 540 350"
      fill="none"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="path-gradient" x1="270" y1="50" x2="270" y2="300" gradientUnits="userSpaceOnUse">
          <stop stop-color="#3080F0" stop-opacity=".12" />
          <stop offset=".5" stop-color="#3080F0" stop-opacity=".72" />
          <stop offset="1" stop-color="#3020A0" stop-opacity=".5" />
        </linearGradient>
      </defs>
      <path d="M270 79V132M128 175H196M344 175H412M270 218V271" stroke="url(#path-gradient)" stroke-width="1.5" />
      <circle cx="270" cy="106" r="3" fill="#3080F0" />
      <circle cx="165" cy="175" r="3" fill="#3080F0" />
      <circle cx="375" cy="175" r="3" fill="#3020A0" />
      <circle cx="270" cy="244" r="3" fill="#3020A0" />
    </svg>

    <div class="diagram-node diagram-node--top">
      <span class="diagram-node__number">01 / FINANCEIRO</span>
      <span class="diagram-node__label">Trading · MQL5</span>
    </div>
    <div class="diagram-node diagram-node--left">
      <span class="diagram-node__number">02 / EMPRESAS</span>
      <span class="diagram-node__label">Sistemas · NeuroLicence</span>
    </div>
    <div class="diagram-node diagram-node--right">
      <span class="diagram-node__number">03 / INFRAESTRUTURA</span>
      <span class="diagram-node__label">HUB do Parceiro</span>
    </div>
    <div class="diagram-node diagram-node--bottom">
      <span class="diagram-node__number">BASE TÉCNICA</span>
      <span class="diagram-node__label">Engenharia de software</span>
    </div>
    <div class="diagram-core">
      <span class="diagram-core__orbit diagram-core__orbit--outer"></span>
      <span class="diagram-core__orbit diagram-core__orbit--inner"></span>
      <img
        class="diagram-core__logo"
        src="/assets/logo-160.webp"
        width="160"
        height="160"
        alt=""
        loading="eager"
        decoding="async"
      />
      <span class="diagram-core__caption">NÚCLEO TÉCNICO</span>
    </div>
  </div>

  <div class="hero-diagram__foot">
    <span class="hero-diagram__status"><span></span> ESTRUTURA CONECTADA</span>
    <span class="hero-diagram__footnote">FINANCEIRO&nbsp; · &nbsp;EMPRESARIAL&nbsp; · &nbsp;PLATAFORMAS</span>
  </div>
</div>
