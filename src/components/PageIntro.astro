---
interface Props {
  number: string;
  label: string;
  title: string;
  accent: string;
  description: string;
}

const { number, label, title, accent, description } = Astro.props;
---

<section class="page-intro" aria-labelledby="page-title">
  <div class="shell mx-auto">
    <div class="page-intro__grid">
      <div>
        <p class="eyebrow">
          <span class="eyebrow__line"></span>
          {number} / {label}
        </p>
        <h1 class="page-intro__title" id="page-title">
          {title} <span>{accent}</span>
        </h1>
      </div>
      <p class="page-intro__description">{description}</p>
    </div>
  </div>
</section>
